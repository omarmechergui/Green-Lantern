# Server Configuration
PORT=5000
NODE_ENV=development

# CORS Configuration
# Comma-separated list or single origin allowed to access the API
CLIENT_ORIGIN=http://localhost:3000

# Database Configuration (MongoDB Atlas Connection String)
# Example: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
DATABASE_URL=mongodb+srv://user:password@cluster.mongodb.net/green_lantern?retryWrites=true&w=majority

# Authentication Configuration
# Provide a strong, cryptographically random secret in production (minimum 32 characters)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d
COOKIE_NAME=gl_token

